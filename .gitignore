node_modules/
scratch-test/

# Electron / packaging output
dist/
out/
build/
release/

# Disposable working copies and backups (never source of truth)
*.edit.wrl
*.bak-*

# Logs
*.log
npm-debug.log*

# Machine-specific visual-QA run output (abs paths/PIDs); RESULTS.md is the
# committed human-readable evidence.
qa/phase-4b-world-preview/RESULTS.json
qa/phase-5a-world-packaging/RESULTS.json
qa/phase-7b-native-editor/RESULTS.json
qa/phase-7b-native-editor/PERF.json
qa/phase-7c-vision/RESULTS.json

# graphify knowledge-graph output (machine-generated, regenerated via `graphify update .`)
graphify-out/

# Native editor CodeMirror bundle (generated by `npm run build:editor` via esbuild
# from src/editor/browser/; regenerated on start/build, never committed)
renderer/vendor/

# Website lives in its own repository; never include it in the app repository.
/site/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Owner's local real-item test collection (UI-THEME-1). Never tracked, staged
# or committed; only these two roots are approved for ad hoc item testing.
/allowed-items-to-test/

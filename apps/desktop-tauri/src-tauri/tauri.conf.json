{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WRL Forge",
  "version": "0.1.0",
  "identifier": "org.ascendance3d.wrlforge.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WRL Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: wrlres:",
        "connect-src": "ipc: http://ipc.localhost 'self' data: blob: wrlres:",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"],
    "publisher": "Ryan Bundy",
    "copyright": "Copyright © 2026 Ryan Bundy (BassMekanik2000) and contributors",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://github.com/Ascendance3D/wrlforge",
    "category": "GraphicsAndDesign",
    "shortDescription": "Standards-first VRML97 model and code editor",
    "longDescription": "WRL Forge edits VRML97 (.wrl) documents losslessly: source editor, scene tree, field inspector and X_ITE 3D preview over one document.",
    "resources": {
      "../target/pkg-licenses/": "licenses/"
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "recommends": ["libvulkan1", "mesa-vulkan-drivers"],
        "files": {
          "/usr/share/doc/wrl-forge/copyright": "../packaging/README-licenses.txt"
        }
      }
    }
  }
}

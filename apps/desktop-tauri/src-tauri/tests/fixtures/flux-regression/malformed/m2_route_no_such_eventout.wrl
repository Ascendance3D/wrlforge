# original WRL Forge test fixture (RUST-STAB-1), INTENTIONALLY MALFORMED.
# PositionInterpolator has no eventOut named key_value (the eventOut is value_changed).
DEF Mover Transform { children [ Shape { geometry Box { } } ] }
DEF PI PositionInterpolator { key [ 0 1 ] keyValue [ 0 0 0   1 1 1 ] }
ROUTE PI.key_value TO Mover.set_translation
